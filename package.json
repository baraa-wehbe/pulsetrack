{
  "name": "pulsetrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,scheduler \"npm:dev:web\" \"npm:dev:scheduler\"",
    "dev:web": "next dev",
    "dev:scheduler": "tsx --tsconfig jsconfig.json scripts/scheduled-assessment-worker.js",
    "build": "next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "clinician:create": "tsx --tsconfig jsconfig.json scripts/create-clinician.js",
    "assessments:deliver-due": "tsx --tsconfig jsconfig.json scripts/deliver-due-assessments.js",
    "benchmark:routes": "tsx --tsconfig jsconfig.json scripts/benchmark-private-routes.js",
    "fhir:sync-patients": "node --conditions=react-server --import tsx scripts/sync-fhir-patients.js",
    "fhir:pull-seeds": "node --conditions=react-server --import tsx scripts/pull-fhir-seeds.js",
    "db:seed": "prisma db seed",
    "test": "tsx --tsconfig jsconfig.json --test prisma/seed.test.js src/server/auth/auth.test.js src/server/auth/create-clinician.test.js src/server/preferences/preferences.test.js src/components/application-shell.test.js src/lib/patient-validation.test.js src/lib/assessment-validation.test.js src/lib/questionnaire.test.js src/server/assessments/assessment-service.test.js src/server/assessments/public-assessment.test.js src/server/patients/patient-list.test.js src/server/patients/patient-detail.test.js src/components/patient-management.test.js",
    "test:seed": "tsx --test prisma/seed.test.js",
    "test:seed:integration": "tsx --test prisma/seed.integration.test.js",
    "test:auth": "tsx --tsconfig jsconfig.json --test src/server/auth/auth.test.js",
    "test:auth:integration": "tsx --tsconfig jsconfig.json --test src/server/auth/auth.integration.test.js",
    "test:auth:e2e": "tsx --tsconfig jsconfig.json scripts/verify-auth-flow.js",
    "test:clinician-create": "tsx --tsconfig jsconfig.json --test src/server/auth/create-clinician.test.js",
    "test:shell": "tsx --tsconfig jsconfig.json --test src/server/preferences/preferences.test.js src/components/application-shell.test.js",
    "test:shell:e2e": "tsx --tsconfig jsconfig.json scripts/verify-shell-flow.js",
    "test:shell:browser": "tsx --tsconfig jsconfig.json scripts/verify-shell-browser.js",
    "test:patients": "tsx --tsconfig jsconfig.json --test src/lib/patient-validation.test.js src/server/patients/patient-list.test.js src/server/patients/patient-detail.test.js src/components/patient-management.test.js",
    "test:patients:integration": "tsx --tsconfig jsconfig.json --test src/server/patients/patients.integration.test.js",
    "test:patients:e2e": "tsx --tsconfig jsconfig.json scripts/verify-patient-flow.js",
    "test:patients:browser": "tsx --tsconfig jsconfig.json scripts/verify-patient-browser.js",
    "test:patients:task07": "tsx --tsconfig jsconfig.json scripts/verify-task07.js",
    "test:patients:task08": "tsx --tsconfig jsconfig.json scripts/verify-task07.js",
    "test:assessments": "tsx --tsconfig jsconfig.json --test src/lib/assessment-validation.test.js src/server/assessments/assessment-service.test.js",
    "test:assessments:integration": "tsx --tsconfig jsconfig.json --test src/server/assessments/assessment.integration.test.js",
    "test:assessment-job": "tsx --tsconfig jsconfig.json --test src/server/assessments/assessment-job.test.js src/lib/assessment-presentation.test.js",
    "test:labs": "tsx --tsconfig jsconfig.json --test src/server/labs/labs.test.js",
    "test:labs:integration": "tsx --tsconfig jsconfig.json --test src/server/labs/labs.integration.test.js",
    "test:lab-report": "tsx --tsconfig jsconfig.json --test src/server/labs/lab-report.test.js",
    "test:patient-dashboard": "tsx --tsconfig jsconfig.json --test src/server/dashboards/patient-dashboard.test.js",
    "test:clinic-dashboard": "tsx --tsconfig jsconfig.json --test src/server/dashboards/clinic-dashboard.test.js",
    "test:tier1:e2e": "tsx --tsconfig jsconfig.json --test src/server/tier1/tier1-flow.integration.test.js",
    "test:tier1:security": "tsx --tsconfig jsconfig.json --test src/server/security/tier1-security.test.js",
    "test:fhir": "tsx --conditions=react-server --tsconfig jsconfig.json --test src/server/fhir/fhir-client.test.js src/server/fhir/fhir-mapping.test.js src/server/fhir/patient-sync.test.js src/server/fhir/observation-sync.test.js",
    "test:fhir:config": "tsx --tsconfig jsconfig.json --test src/config/fhir.test.js",
    "test:fhir:observations": "tsx --conditions=react-server --tsconfig jsconfig.json --test src/server/fhir/fhir-mapping.test.js src/server/fhir/observation-sync.test.js",
    "test:fhir:pull": "tsx --conditions=react-server --tsconfig jsconfig.json --test src/server/fhir/seed-pull.test.js src/server/fhir/seed-pull.integration.test.js",
    "test:fhir:status": "tsx --conditions=react-server --tsconfig jsconfig.json --test src/server/fhir/fhir-status.test.js",
    "test:public-assessment": "tsx --tsconfig jsconfig.json --test src/lib/questionnaire.test.js src/server/assessments/public-assessment.test.js",
    "test:public-assessment:integration": "tsx --tsconfig jsconfig.json --test src/server/assessments/public-assessment.integration.test.js",
    "test:public-assessment:browser": "tsx --tsconfig jsconfig.json scripts/verify-public-assessment.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@tailwindcss/postcss": "^4.3.3",
    "argon2": "^0.45.1",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.8.1",
    "dotenv": "^17.4.2",
    "next": "^16.2.11",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1"
  }
}
