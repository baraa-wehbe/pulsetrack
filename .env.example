DATABASE_URL=postgresql://pulsetrack:pulsetrack_dev_password@localhost:5433/pulsetrack?schema=public
AUTH_SECRET=replace-with-a-secret-containing-at-least-32-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only assessment email delivery. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_with_a_development_or_production_key
ASSESSMENT_EMAIL_FROM=PulseTrack <assessments@example.local>

# Server-only bearer secret for POST /api/scheduled/assessments (minimum 32 characters).
SCHEDULER_SECRET=replace-with-a-random-scheduler-secret-at-least-32-characters

# Maximum accepted lab CSV upload size in bytes (default: 5 MiB).
LAB_CSV_MAX_BYTES=5242880

# Optional server-only FHIR R4 client configuration.
FHIR_BASE_URL=
FHIR_API_KEY=
FHIR_REQUEST_TIMEOUT_MS=10000
FHIR_MRN_IDENTIFIER_SYSTEM=
FHIR_LAB_RESULT_IDENTIFIER_SYSTEM=
